# Required, set your Anthropic API key.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Optional, uncomment and set when running without the Slack CLI (python3 app.py).
# SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
# SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN

# Required for OAuth (app_oauth.py). Set your app's OAuth credentials.
# SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
# SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
# SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
# SLACK_REDIRECT_URI=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app/slack/oauth_redirect

# Optional, uncomment and set when using a custom Slack instance.
# SLACK_API_URL=YOUR_SLACK_API_URL

# --- Task hand-off workflow -------------------------------------------------
# Channel the bot watches for requests, and channel where task cards are posted.
# Either a channel name (resolved at startup) or an ID. The bot must be a member of both.
TASK_SOURCE_CHANNEL_ID=all-gk
TASK_TARGET_CHANNEL_ID=social

# Safety allowlists (comma-separated). Anything else is never touched.
# TASK_ALLOWED_REPOS=my-org/gitops,my-org/helm-values
# TASK_ALLOWED_KUBE_CONTEXTS=prod-us-east-1,staging

# GitHub OAuth App (or GitHub App) client ID with "Enable Device Flow" checked.
# Used by /link-github so PRs are opened by the person who picks up the task.
# GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxx
# GITHUB_API_URL=https://api.github.com
# GITHUB_OAUTH_URL=https://github.com

# Fernet key used to encrypt stored GitHub tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=

# Optional
# TASKS_DB_PATH=data/tasks.db
# TASK_CLASSIFIER_MODEL=
# KUBECTL_PATH=kubectl
